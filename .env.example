# Copie para .env e preencha. O agente usa UM provedor / UM modelo / UMA config.
# Interface OpenAI-compativel (agent/llm.py) — funciona com Groq, OpenAI, etc.

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
LLM_TPM_HEADROOM=2500          # folga de tokens/min antes de pausar (free tier da Groq = 8000 TPM)

GROQ_API_KEY=coloque_sua_chave_aqui
# Para outro provedor OpenAI-compativel, use LLM_PROVIDER!=groq e:
# LLM_API_KEY=...
